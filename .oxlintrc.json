{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "useRoute",
          "useStore",
          "useAudit",
          "useCompany",
          "useSettings",
          "useInvoices",
          "useCustomers",
          "useVendors",
          "useAccounts",
          "useProducts",
          "useBankTxns",
          "useRules",
          "useBills",
          "useExpenses",
          "useNotifications",
          "useDashboard",
          "useTaxRates",
          "useJournalEntries",
          "useUsers",
          "useTimeEntries",
          "usePayrollRuns",
          "useMileage",
          "useBankAccounts",
          "useRecurring",
          "useBudgets",
          "useEstimates",
          "usePayments",
          "useUi",
          "useFavorites",
          "useBookmarks",
          "useCategories",
          "SEED",
          "INITIAL_AUDIT_LOGS",
          "INITIAL_RULES",
          "INITIAL_CHART_OF_ACCOUNTS"
        ]
      }
    ]
  }
}
